DATABASE_URL="postgresql://user:password@localhost:5432/ai_research"
# Use Supabase's direct database host for Prisma schema changes; use the pooler URL at runtime.
DIRECT_URL="postgresql://user:password@db.example.supabase.co:5432/postgres"
AUTH_SECRET="replace-with-a-long-random-secret"
UNSUBSCRIBE_TOKEN_SECRET="replace-with-a-separate-long-random-secret"
# Set only during a controlled unsubscribe-token key rotation window.
UNSUBSCRIBE_TOKEN_PREVIOUS_SECRET=""
AI_API_KEY=""
AI_API_URL=""
AI_MODEL=""
ANALYSIS_AI_API_KEY=""
ANALYSIS_AI_API_URL=""
ANALYSIS_AI_MODEL=""
LEARNING_AI_API_KEY=""
LEARNING_AI_API_URL=""
LEARNING_AI_MODEL=""
LEARNING_AI_TIMEOUT_MS="30000"
# Optional. Without these values, research reports use the deterministic grounded rules fallback.
RESEARCH_AI_API_KEY=""
RESEARCH_AI_API_URL=""
RESEARCH_AI_MODEL=""
RESEARCH_AI_TIMEOUT_MS="30000"
EMAIL_API_KEY=""
EMAIL_FROM="research@example.com"
DIGEST_EMAIL_FROM="digest@example.com"
CRON_SECRET="replace-with-a-long-random-secret"
APP_URL="http://127.0.0.1:3000"
ADMIN_EMAILS="admin@example.com"
ALERT_EMAIL_TO="admin@example.com"
PRODUCT_HUNT_ENABLED="false"
PRODUCT_HUNT_CLIENT_ID=""

REDDIT_ENABLED="false"
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
REDDIT_USER_AGENT=""
GITHUB_TOKEN=""
# Comma-separated owner/repository values for dedicated GitHub trend collection.
GITHUB_TREND_REPOS=""
# JSON array: [{"slug":"ai-papers","name":"AI Papers","conceptId":"C154945302","windowDays":30}]
TREND_PAPER_TOPICS_JSON="[]"
# Authorized model/product or job JSON feeds. JOB entries must include sourceLicense.
TREND_FEEDS_JSON="[]"
# Feed bearer tokens must use names beginning with TREND_FEED_TOKEN_.
TREND_FEED_TOKEN_EXAMPLE=""
STACKEXCHANGE_API_KEY=""
EMBEDDING_API_KEY=""
EMBEDDING_API_URL="https://dashscope.aliyuncs.com/compatible-mode/v1/embeddings"

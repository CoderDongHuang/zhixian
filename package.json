{
  "name": "ai-industry-research-platform",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "next build",
    "test:e2e": "node tests/smoke.mjs",
    "test:performance": "node tests/performance.mjs",
    "test:push": "node --test tests/push-delivery.test.mjs",
    "test:learning": "node --experimental-strip-types --test tests/learning-ai.test.ts",
    "test:wechat": "node --experimental-strip-types --test tests/wechat-sync.test.ts",
    "test:entities": "node --experimental-strip-types --test tests/entities.test.ts",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "invite:create": "node --env-file-if-exists=.env scripts/create-invite.mjs",
    "sources:ingest": "node --env-file-if-exists=.env scripts/ingest-sources.mjs",
    "sources:community": "node --env-file-if-exists=.env scripts/ingest-community.mjs",
    "content:embed": "node --env-file-if-exists=.env scripts/embed-documents.mjs",
    "alerts:keywords": "node --env-file-if-exists=.env scripts/send-keyword-alerts.mjs",
    "industry:seed": "node --env-file-if-exists=.env scripts/seed-industry.mjs",
    "entities:extract": "node --env-file-if-exists=.env scripts/extract-entities.mjs",
    "content:process": "node --env-file-if-exists=.env scripts/process-documents.mjs",
    "content:analyze": "node --env-file-if-exists=.env scripts/analyze-events.mjs",
    "reviews:auto-resolve": "node --env-file-if-exists=.env scripts/auto-resolve-reviews.mjs",
    "digest:morning": "node --env-file-if-exists=.env scripts/generate-digest.mjs MORNING",
    "digest:evening": "node --env-file-if-exists=.env scripts/generate-digest.mjs EVENING",
    "digest:weekly": "node --env-file-if-exists=.env scripts/generate-digest.mjs WEEKLY",
    "digest:send:morning": "node --env-file-if-exists=.env scripts/send-digests.mjs MORNING",
    "digest:send:evening": "node --env-file-if-exists=.env scripts/send-digests.mjs EVENING",
    "digest:send:weekly": "node --env-file-if-exists=.env scripts/send-digests.mjs WEEKLY",
    "assets:brand": "node scripts/build-brand-assets.mjs",
    "push:send": "node --env-file-if-exists=.env scripts/send-push.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.12.0",
    "@types/web-push": "^3.6.4",
    "ajv": "^8.20.0",
    "fast-xml-parser": "^5.10.1",
    "next": "^15.4.0",
    "pg": "^8.22.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "^6.12.0",
    "typescript": "^5.0.0"
  }
}

{
  "name": "ai-industry-research-platform",
  "private": true,
  "workspaces": [
    "mobile-app"
  ],
  "version": "0.4.0-rc.1",
  "overrides": {
    "@expo/plist": { "@xmldom/xmldom": "0.8.15" },
    "@expo/xcpretty": { "js-yaml": "4.3.2" },
    "expo": "54.0.37",
    "expo-constants": "18.0.14",
    "expo-file-system": "19.0.24",
    "fast-uri": "3.1.8",
    "nanoid": "3.3.18",
    "postcss": "8.5.23",
    "sharp": "0.35.5"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "next build",
    "test:smoke": "node tests/smoke.mjs",
    "test:e2e": "playwright test",
    "test:performance": "node tests/performance.mjs",
    "test:push": "node --test tests/push-delivery.test.mjs",
    "test:receipts": "node --test tests/expo-receipts.test.mjs",
    "test:learning": "node --experimental-strip-types --test tests/learning-ai.test.ts",
    "test:wechat": "node --experimental-strip-types --test tests/wechat-sync.test.ts",
    "test:miniprogram": "node --test tests/miniprogram-client.test.mjs",
    "test:p1-policies": "node --test tests/p1-policies.test.mjs",
    "test:p2-policies": "node --test tests/p2-policies.test.mjs",
    "test:research": "node --test tests/evidence-policy.test.mjs && node --experimental-strip-types --test tests/research-policy.test.ts",
    "test:trends": "node --test tests/trend-policy.test.mjs",
    "test:research-agent": "node --experimental-strip-types --test tests/research-agent.test.ts",
    "audit:prod": "node scripts/check-dependency-audit.mjs",
    "test:entities": "node --experimental-strip-types --test tests/entities.test.ts",
    "test:unit": "npm run test:push && npm run test:receipts && npm run test:learning && npm run test:wechat && npm run test:entities && npm run test:miniprogram && npm run test:p1-policies && npm run test:p2-policies && npm run test:research && npm run test:trends && npm run test:research-agent && npm run test:release",
    "monitor:production": "node scripts/monitor-production.mjs",
    "start": "next start",
    "lint": "eslint app lib scripts tests --ext .js,.mjs,.ts,.tsx --max-warnings=0",
    "typecheck": "tsc --project tsconfig.app.json --pretty false",
    "typecheck:test": "tsc --project tsconfig.test.json --pretty false",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate:deploy": "prisma migrate deploy",
    "invite:create": "node --env-file-if-exists=.env scripts/create-invite.mjs",
    "sources:ingest": "node --env-file-if-exists=.env scripts/ingest-sources.mjs",
    "sources:community": "node --env-file-if-exists=.env scripts/ingest-community.mjs",
    "content:embed": "node --env-file-if-exists=.env scripts/embed-documents.mjs",
    "alerts:keywords": "node --env-file-if-exists=.env scripts/send-keyword-alerts.mjs",
    "industry:seed": "node --env-file-if-exists=.env scripts/seed-industry.mjs",
    "entities:extract": "node --env-file-if-exists=.env scripts/extract-entities.mjs",
    "content:process": "node --env-file-if-exists=.env scripts/process-documents.mjs",
    "content:analyze": "node --env-file-if-exists=.env scripts/analyze-events.mjs",
    "reviews:auto-resolve": "node --env-file-if-exists=.env scripts/auto-resolve-reviews.mjs",
    "trends:collect": "node --env-file-if-exists=.env scripts/collect-trends.mjs",
    "trends:forecast": "node --env-file-if-exists=.env scripts/generate-trend-forecasts.mjs",
    "digest:morning": "node --env-file-if-exists=.env scripts/generate-digest.mjs MORNING",
    "digest:evening": "node --env-file-if-exists=.env scripts/generate-digest.mjs EVENING",
    "digest:weekly": "node --env-file-if-exists=.env scripts/generate-digest.mjs WEEKLY",
    "digest:send:morning": "node --env-file-if-exists=.env scripts/send-digests.mjs MORNING",
    "digest:send:evening": "node --env-file-if-exists=.env scripts/send-digests.mjs EVENING",
    "digest:send:weekly": "node --env-file-if-exists=.env scripts/send-digests.mjs WEEKLY",
    "assets:brand": "node scripts/build-brand-assets.mjs",
    "push:send": "node --env-file-if-exists=.env scripts/send-push.mjs",
    "push:receipts": "node --env-file-if-exists=.env scripts/check-expo-receipts.mjs",
    "data:cleanup": "node --env-file-if-exists=.env scripts/cleanup-data.mjs",
    "mobile:assets": "node scripts/build-mobile-assets.mjs",
    "release:check": "node scripts/check-mobile-release-readiness.mjs --build",
    "release:check:submit": "node scripts/check-mobile-release-readiness.mjs --submit",
    "test:release": "node --test tests/mobile-release-readiness.test.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "@types/web-push": "^3.6.4",
    "ajv": "^8.20.0",
    "fast-xml-parser": "^5.10.1",
    "next": "^15.5.27",
    "pg": "^8.22.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^22.0.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.27",
    "prisma": "6.12.0",
    "typescript": "^5.0.0"
  }
}

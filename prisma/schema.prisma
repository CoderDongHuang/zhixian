generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ReviewStatus {
  AUTO_PUBLISHED
  PENDING_REVIEW
  APPROVED
  REJECTED
  STALE
}

enum DocumentLanguage {
  ZH
  EN
  OTHER
}

enum ProcessingStatus {
  PENDING
  PROCESSED
  WAITING_TRANSLATION
  FAILED
}

enum DigestType {
  MORNING
  EVENING
  WEEKLY
}

enum DeliveryStatus {
  SENT
  FAILED
}

enum EntityType {
  COMPANY
  PERSON
  PRODUCT
  TECHNOLOGY
  OPEN_SOURCE_PROJECT
}

enum AlertStatus {
  PENDING
  SENT
  FAILED
}

enum PushDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  EXPIRED
}

enum EvidenceStance {
  SUPPORT
  CONFLICT
  CONTEXT
}

enum CorrectionStatus {
  PENDING
  RESOLVED
  REJECTED
}

enum ResearchItemType {
  EVENT
  ENTITY
  DIGEST
}

enum TrendCategory {
  GITHUB
  MODEL_PRODUCT
  PAPER
  JOB
}

enum ResearchAgentMode {
  QUESTION
  COMPARE
  CHANGES_30D
}

enum ResearchAgentStatus {
  AWAITING_CONFIRMATION
  RUNNING
  COMPLETED
  REFUSED
  FAILED
  CANCELLED
}

enum LearningTaskType {
  READING
  PRACTICE
  CODE
  REVIEW
}

model User {
  id                    String                 @id @default(cuid())
  email                 String?                @unique
  createdAt             DateTime               @default(now())
  preference            UserPreference?
  bookmarks             Bookmark[]
  reads                 ReadHistory[]
  feedback              Feedback[]
  sessions              Session[]
  digests               Digest[]
  deliveries            EmailDelivery[]
  keywords              KeywordSubscription[]
  alerts                AlertDelivery[]
  devices               DeviceSubscription[]
  pushIntents           WebPushIntent[]
  behaviors             BehaviorEvent[]
  learningPaths         LearningPath[]
  learningTasks         LearningTask[]
  learningAttempts      LearningAttempt[]
  learningReviews       LearningReview[]
  exports               ReportExport[]
  pushDeliveries        PushDelivery[]
  wechatIdentities      WechatIdentity[]
  miniSessions          MiniSession[]
  syncStates            SyncState[]
  syncChanges           SyncChange[]
  syncRequests          SyncRequest[]
  entitySubscriptions   EntitySubscription[]
  researchCollections   ResearchCollection[]
  researchShares        ResearchShare[]
  researchNotifications ResearchNotification[]
  researchAgentTasks     ResearchAgentTask[]
}

model WechatIdentity {
  id        String   @id @default(cuid())
  userId    String
  appId     String
  openId    String
  unionId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([appId, openId])
  @@index([unionId])
  @@index([userId])
}

model MiniSession {
  id               String    @id @default(cuid())
  userId           String
  deviceId         String
  refreshTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([expiresAt, revokedAt])
}

model SyncState {
  id              String   @id @default(cuid())
  userId          String
  resource        String
  resourceId      String
  value           Json
  clientChangedAt DateTime
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, resource, resourceId])
}

model SyncChange {
  sequence   BigInt   @id @default(autoincrement())
  userId     String
  resource   String
  resourceId String
  value      Json
  changedAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sequence])
  @@index([changedAt])
}

model SyncRequest {
  id             String   @id @default(cuid())
  userId         String
  deviceId       String
  idempotencyKey String
  response       Json
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId, idempotencyKey])
  @@index([createdAt])
}

model Invitation {
  id        String    @id @default(cuid())
  code      String    @unique
  email     String?
  usedAt    DateTime?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
}

model EmailOtp {
  id           String    @id @default(cuid())
  email        String
  codeHash     String
  expiresAt    DateTime
  usedAt       DateTime?
  attemptCount Int       @default(0)
  lockedAt     DateTime?
  createdAt    DateTime  @default(now())

  @@index([email, expiresAt])
  @@index([expiresAt])
}

model AuthThrottle {
  key             String    @id
  scope           String
  count           Int       @default(0)
  windowStartedAt DateTime
  blockedUntil    DateTime?
  updatedAt       DateTime  @updatedAt

  @@index([scope, blockedUntil])
  @@index([updatedAt])
}

model SecurityEvent {
  id          String   @id @default(cuid())
  kind        String
  subjectHash String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([kind, createdAt])
  @@index([subjectHash, createdAt])
  @@index([createdAt])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model UserPreference {
  id                   String   @id @default(cuid())
  userId               String   @unique
  identity             String?
  skillDirections      String[] @default([])
  level                String?
  topics               String[]
  readingMinutes       Int?
  learningGoals        String[] @default([])
  morningTime          String?
  eveningTime          String?
  timezone             String   @default("Asia/Shanghai")
  morningEnabled       Boolean  @default(true)
  eveningEnabled       Boolean  @default(true)
  weeklyEnabled        Boolean  @default(true)
  weeklyDay            Int      @default(0)
  emailEnabled         Boolean  @default(true)
  itemsPerDigest       Int      @default(10)
  pushEnabled          Boolean  @default(false)
  dailyLearningEnabled Boolean  @default(true)
  dailyLearningTime    String   @default("07:30")
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DeviceSubscription {
  id         String   @id @default(cuid())
  userId     String
  endpoint   String   @unique
  p256dh     String
  auth       String
  platform   String   @default("web")
  userAgent  String?
  categories Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, platform])
}

model BehaviorEvent {
  id         String   @id @default(cuid())
  userId     String
  feedItemId String?
  eventId    String?
  action     String
  topic      String?
  value      Float    @default(1)
  metadata   Json?
  dedupeKey  String?  @unique
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, topic, action])
  @@index([createdAt])
}

model LearningPath {
  id                    String         @id @default(cuid())
  userId                String
  title                 String
  goal                  String
  level                 String
  topics                String[]
  outline               Json
  progress              Int            @default(0)
  active                Boolean        @default(true)
  modelVersion          String         @default("rules-v1")
  promptVersion         String         @default("learning-path-v1")
  generationReason      String?
  preferenceFingerprint String?
  stale                 Boolean        @default(false)
  generatedAt           DateTime       @default(now())
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks                 LearningTask[]

  @@index([userId, active])
}

model LearningTask {
  id                 String            @id @default(cuid())
  userId             String
  pathId             String?
  eventId            String?
  entityId           String?
  taskType           LearningTaskType  @default(READING)
  prerequisiteTaskId String?
  title              String
  description        String
  reason             String?
  exercise           Json?
  estimatedMinutes   Int               @default(15)
  scheduledFor       DateTime
  dayKey             String?
  dayTimezone        String?
  completedAt        DateTime?
  qualityScore       Int?
  selfRating         Int?
  reflection         String?
  attemptCount       Int               @default(0)
  nextReviewAt       DateTime?
  lastAttemptAt      DateTime?
  createdAt          DateTime          @default(now())
  modelVersion       String            @default("rules-v1")
  promptVersion      String            @default("daily-task-v1")
  generationReason   String?
  generatedAt        DateTime          @default(now())
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  path               LearningPath?     @relation(fields: [pathId], references: [id], onDelete: SetNull)
  event              Event?            @relation(fields: [eventId], references: [id], onDelete: SetNull)
  entity             Entity?           @relation(fields: [entityId], references: [id], onDelete: SetNull)
  prerequisite       LearningTask?     @relation("LearningTaskPrerequisite", fields: [prerequisiteTaskId], references: [id], onDelete: SetNull)
  dependentTasks     LearningTask[]    @relation("LearningTaskPrerequisite")
  attempts           LearningAttempt[]
  reviews            LearningReview[]

  @@index([userId, scheduledFor])
  @@unique([userId, pathId, dayKey])
  @@index([userId, taskType, scheduledFor])
  @@index([eventId])
  @@index([entityId])
  @@index([prerequisiteTaskId])
}

model LearningAttempt {
  id                String       @id @default(cuid())
  userId            String
  taskId            String
  requestId         String?
  requestHash       String?
  response          Json?
  answers           Json
  score             Int
  maxScore          Int
  qualityScore      Int
  feedback          Json
  incorrectConcepts String[]
  submittedAt       DateTime     @default(now())
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  task              LearningTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([userId, submittedAt])
  @@index([taskId, submittedAt])
  @@unique([userId, taskId, requestId])
}

model WebPushIntent {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String
  changedAt BigInt
  enabled   Boolean
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint])
}

model LearningReview {
  id             String       @id @default(cuid())
  userId         String
  taskId         String
  concept        String
  prompt         String
  options        Json?
  correctAnswers Json
  intervalDays   Int          @default(1)
  easeFactor     Float        @default(2.5)
  repetition     Int          @default(0)
  dueAt          DateTime
  lastReviewedAt DateTime?
  resolvedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  task           LearningTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([userId, taskId, concept])
  @@index([userId, dueAt, resolvedAt])
  @@index([taskId])
}

model ReportExport {
  id             String   @id @default(cuid())
  userId         String
  digestId       String?
  idempotencyKey String?
  template       String
  format         String
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  digest         Digest?  @relation(fields: [digestId], references: [id], onDelete: SetNull)

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([createdAt])
}

model Digest {
  id             String          @id @default(cuid())
  key            String          @unique
  userId         String?
  type           DigestType
  title          String
  overview       String
  content        Json
  periodStart    DateTime
  periodEnd      DateTime
  createdAt      DateTime        @default(now())
  user           User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries     EmailDelivery[]
  pushDeliveries PushDelivery[]
  exports        ReportExport[]

  @@index([userId, type, createdAt])
  @@index([createdAt])
}

model PushDelivery {
  id               String             @id @default(cuid())
  userId           String
  digestId         String
  deviceId         String
  endpointHash     String
  status           PushDeliveryStatus @default(PENDING)
  retryCount       Int                @default(0)
  providerId       String?
  error            String?
  nextAttemptAt    DateTime?
  lastAttemptAt    DateTime?
  sentAt           DateTime?
  receiptStatus    String?
  receiptCheckedAt DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  digest           Digest             @relation(fields: [digestId], references: [id], onDelete: Cascade)

  @@unique([deviceId, digestId])
  @@index([status, nextAttemptAt])
  @@index([userId, createdAt])
}

model EmailDelivery {
  id         String         @id @default(cuid())
  digestId   String
  userId     String
  recipient  String
  status     DeliveryStatus
  providerId String?
  error      String?
  sentAt     DateTime?
  createdAt  DateTime       @default(now())
  digest     Digest         @relation(fields: [digestId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([digestId, userId])
  @@index([status, createdAt])
}

model Source {
  id            String           @id @default(cuid())
  name          String
  url           String
  type          String
  language      DocumentLanguage
  trustScore    Float            @default(0.5)
  etag          String?
  lastModified  String?
  lastFetchedAt DateTime?
  fetchVersion  Int              @default(0)
  documents     RawDocument[]
  snapshots     SourceSnapshot[]
}

model RawDocument {
  id                String           @id @default(cuid())
  sourceId          String
  url               String           @unique
  title             String
  content           String?
  translatedContent String?
  language          DocumentLanguage
  publishedAt       DateTime?
  fetchedAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  contentHash       String
  materialRevision  Int              @default(0)
  cleanedContent    String?
  topic             String?
  processingStatus  ProcessingStatus @default(PENDING)
  processedAt       DateTime?
  processingError   String?
  source            Source           @relation(fields: [sourceId], references: [id])
  events            EventDocument[]
  evidence          Evidence[]
  mentions          EntityMention[]
  embeddings        Embedding[]
  snapshots         SourceSnapshot[]

  @@index([contentHash])
  @@index([sourceId, fetchedAt])
}

model SourceSnapshot {
  id          String       @id @default(cuid())
  sourceId    String
  documentId  String?
  url         String
  title       String
  content     String?
  contentHash String
  metrics     Json?
  publishedAt DateTime?
  fetchedAt   DateTime     @default(now())
  source      Source       @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  document    RawDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([sourceId, fetchedAt])
  @@index([url, fetchedAt])
  @@index([documentId, fetchedAt])
  @@index([fetchedAt])
}

model Event {
  id                String          @id @default(cuid())
  title             String
  clusterKey        String          @unique
  topic             String?
  type              String
  importance        Float           @default(0.5)
  isPublic          Boolean         @default(false)
  materialRevision  Int             @default(0)
  createdAt         DateTime        @default(now())
  documents         EventDocument[]
  analyses          Analysis[]
  feedItems         FeedItem[]
  mentions          EntityMention[]
  timeline          EventTimeline[]
  outgoingRelations EventRelation[] @relation("EventFrom")
  incomingRelations EventRelation[] @relation("EventTo")
  alerts            AlertDelivery[]
  learningTasks     LearningTask[]

  @@index([topic])
  @@index([isPublic, createdAt])
}

model EventDocument {
  eventId       String
  documentId    String
  clusterMethod String      @default("ORDERED_TITLE_V2")
  clusterScore  Float?
  clusterReason String?
  event         Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  document      RawDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([eventId, documentId])
}

model PipelineRun {
  id           String   @id @default(cuid())
  name         String
  status       String
  inputCount   Int      @default(0)
  outputCount  Int      @default(0)
  failureCount Int      @default(0)
  summary      Json
  startedAt    DateTime
  finishedAt   DateTime @default(now())

  @@index([name, finishedAt])
  @@index([status, finishedAt])
  @@index([finishedAt])
}

model PipelineTask {
  id           String   @id @default(cuid())
  key          String   @unique
  name         String
  resourceId   String
  revision     String
  status       String   @default("PENDING")
  token        String?
  leaseUntil   DateTime?
  retryAt      DateTime?
  attemptCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  attempts     PipelineAttempt[]

  @@index([name, status, retryAt])
  @@index([status, leaseUntil])
}

model PipelineAttempt {
  id         String       @id @default(cuid())
  taskId     String
  token      String       @unique
  status     String
  errorCode  String?
  startedAt  DateTime     @default(now())
  finishedAt DateTime?
  task       PipelineTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  calls      AiCall[]

  @@index([taskId, startedAt])
}

model AiCall {
  id               String           @id @default(cuid())
  attemptId        String?
  scope            String
  model            String
  provider         String
  status           String
  httpStatus       Int?
  inputTokens      Int?
  outputTokens     Int?
  costUsd          Float?
  pricingVersion   String?
  durationMs       Int
  createdAt        DateTime         @default(now())
  attempt          PipelineAttempt? @relation(fields: [attemptId], references: [id], onDelete: SetNull)

  @@index([scope, createdAt])
  @@index([createdAt])
}

model Analysis {
  id                String       @id @default(cuid())
  eventId           String
  inputRevision     Int?
  inputManifest     Json?
  summary           String
  whyImportant      String?
  impact            String?
  developerImpact   String?
  learnerAdvice     String?
  advice            String?
  facts             String?
  predictions       String?
  verificationNotes String?
  confidence        Float
  status            ReviewStatus @default(PENDING_REVIEW)
  modelVersion      String
  verifierModel     String?
  promptVersion     String       @default("day5-v1")
  analyzedAt        DateTime     @default(now())
  event             Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  evidence          Evidence[]

  @@index([eventId, status, analyzedAt])
}

model Evidence {
  id         String         @id @default(cuid())
  documentId String
  analysisId String?
  quote      String
  stance     EvidenceStance @default(SUPPORT)
  document   RawDocument    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  analysis   Analysis?      @relation(fields: [analysisId], references: [id], onDelete: SetNull)
}

model FeedItem {
  id          String        @id @default(cuid())
  eventId     String
  publishedAt DateTime      @default(now())
  rank        Float         @default(0.5)
  event       Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  bookmarks   Bookmark[]
  reads       ReadHistory[]
  feedback    Feedback[]

  @@index([publishedAt])
}

model Bookmark {
  id         String   @id @default(cuid())
  userId     String
  feedItemId String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  feedItem   FeedItem @relation(fields: [feedItemId], references: [id], onDelete: Cascade)

  @@unique([userId, feedItemId])
}

model ReadHistory {
  id         String   @id @default(cuid())
  userId     String
  feedItemId String
  readAt     DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  feedItem   FeedItem @relation(fields: [feedItemId], references: [id], onDelete: Cascade)

  @@unique([userId, feedItemId])
  @@index([userId, readAt])
}

model Feedback {
  id               String                @id @default(cuid())
  userId           String
  feedItemId       String
  helpful          Boolean?
  report           String?
  correctionStatus CorrectionStatus?
  resolution       String?
  resolvedAt       DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  feedItem         FeedItem              @relation(fields: [feedItemId], references: [id], onDelete: Cascade)
  notification     ResearchNotification?
}

model Entity {
  id                String               @id @default(cuid())
  type              EntityType
  name              String
  normalized        String
  description       String?
  metadata          Json?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  mentions          EntityMention[]
  aliases           EntityAlias[]
  embeddings        Embedding[]
  outgoingRelations EntityRelation[]     @relation("EntityFrom")
  incomingRelations EntityRelation[]     @relation("EntityTo")
  mergesAsTarget    EntityMerge[]        @relation("EntityMergeTarget")
  subscriptions     EntitySubscription[]
  trendSubjects     TrendSubject[]
  learningTasks     LearningTask[]

  @@unique([type, normalized])
  @@index([type, name])
  @@index([updatedAt])
}

model TrendSubject {
  id            String          @id @default(cuid())
  slug          String          @unique
  name          String
  category      TrendCategory
  description   String?
  sourceName    String
  sourceUrl     String
  sourceLicense String?
  methodology   String
  entityId      String?
  enabled       Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  entity        Entity?         @relation(fields: [entityId], references: [id], onDelete: SetNull)
  snapshots     TrendSnapshot[]
  forecasts     TrendForecast[]

  @@index([category, enabled, updatedAt])
  @@index([entityId])
}

model TrendSnapshot {
  id                 String       @id @default(cuid())
  subjectId          String
  observedAt         DateTime
  windowDays         Int          @default(30)
  metrics            Json
  dimensions         Json?
  dataGaps           String[]     @default([])
  methodologyVersion String       @default("trend-v1")
  sourceUrl          String
  sourceFetchedAt    DateTime
  createdAt          DateTime     @default(now())
  subject            TrendSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([subjectId, observedAt])
  @@index([subjectId, observedAt])
  @@index([observedAt])
}

model TrendForecast {
  id                  String       @id @default(cuid())
  subjectId           String
  metricKey           String
  horizonDays         Int
  generatedAt         DateTime     @default(now())
  targetAt            DateTime
  forecastValue       Float
  lowerBound          Float
  upperBound          Float
  confidenceLevel     Float        @default(0.8)
  method              String
  backtestMae         Float
  backtestMape        Float?
  sampleSize          Int
  trainingWindowStart DateTime
  trainingWindowEnd   DateTime
  invalidationRule    String
  subject             TrendSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([subjectId, metricKey, horizonDays, trainingWindowEnd], map: "TrendForecast_subject_metric_horizon_training_end_key")
  @@index([subjectId, metricKey, generatedAt])
  @@index([targetAt])
}

model EntitySubscription {
  id        String   @id @default(cuid())
  userId    String
  entityId  String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  entity    Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([userId, entityId])
  @@index([userId, enabled])
  @@index([entityId, enabled])
}

model ResearchCollection {
  id          String                   @id @default(cuid())
  userId      String
  title       String
  description String?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  user        User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       ResearchCollectionItem[]
  shares      ResearchShare[]
  agentTasks  ResearchAgentTask[]

  @@index([userId, updatedAt])
}

model ResearchAgentTask {
  id               String              @id @default(cuid())
  userId           String
  collectionId     String
  question         String
  mode             ResearchAgentMode
  status           ResearchAgentStatus @default(AWAITING_CONFIRMATION)
  outline          Json
  evidenceSnapshot Json
  executionToken   String?
  answer           Json?
  refusalReason    String?
  modelVersion     String?
  error            String?
  confirmedAt      DateTime?
  completedAt      DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  collection       ResearchCollection  @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  events           ResearchAgentEvent[]

  @@index([userId, createdAt])
  @@index([collectionId, createdAt])
  @@index([status, updatedAt])
}

model ResearchAgentEvent {
  id        String              @id @default(cuid())
  taskId    String
  status    ResearchAgentStatus
  detail    String?
  createdAt DateTime            @default(now())
  task      ResearchAgentTask   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@index([createdAt])
}

model ResearchCollectionItem {
  id           String             @id @default(cuid())
  collectionId String
  targetType   ResearchItemType
  targetId     String
  targetTitle  String
  note         String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  collection   ResearchCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([collectionId, targetType, targetId])
  @@index([collectionId, createdAt])
}

model ResearchShare {
  id           String             @id @default(cuid())
  collectionId String
  createdById  String
  tokenHash    String             @unique
  version      Int                @default(1)
  legacyVersion Int?
  snapshot     Json
  createdAt    DateTime           @default(now())
  expiresAt    DateTime?
  revokedAt    DateTime?
  collection   ResearchCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  createdBy    User               @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@unique([collectionId, version])
  @@index([collectionId, createdAt])
  @@index([createdById, createdAt])
}

model ResearchNotification {
  id         String    @id @default(cuid())
  userId     String
  feedbackId String    @unique
  title      String
  message    String
  href       String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  feedback   Feedback  @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model EntityAlias {
  id         String @id @default(cuid())
  entityId   String
  alias      String
  normalized String
  entity     Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([entityId, normalized])
  @@index([alias])
}

model EntityRelation {
  fromEntityId String
  toEntityId   String
  relation     String
  confidence   Float    @default(0.5)
  evidence     String?
  sourceUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  fromEntity   Entity   @relation("EntityFrom", fields: [fromEntityId], references: [id], onDelete: Cascade)
  toEntity     Entity   @relation("EntityTo", fields: [toEntityId], references: [id], onDelete: Cascade)

  @@id([fromEntityId, toEntityId, relation])
  @@index([relation, confidence])
  @@index([toEntityId])
}

model EntityMerge {
  id             String   @id @default(cuid())
  sourceEntityId String
  sourceName     String
  targetEntityId String
  mergedByUserId String
  reason         String?
  createdAt      DateTime @default(now())
  targetEntity   Entity   @relation("EntityMergeTarget", fields: [targetEntityId], references: [id], onDelete: Restrict)

  @@index([targetEntityId, createdAt])
  @@index([mergedByUserId, createdAt])
}

model EntityMention {
  entityId   String
  eventId    String
  documentId String?
  context    String?
  entity     Entity       @relation(fields: [entityId], references: [id], onDelete: Cascade)
  event      Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  document   RawDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@id([entityId, eventId])
  @@index([eventId])
}

model EventTimeline {
  id          String   @id @default(cuid())
  eventId     String
  occurredAt  DateTime
  label       String
  description String
  sourceUrl   String?
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, occurredAt])
  @@index([occurredAt])
}

model EventRelation {
  fromEventId String
  toEventId   String
  relation    String
  confidence  Float  @default(0.5)
  fromEvent   Event  @relation("EventFrom", fields: [fromEventId], references: [id], onDelete: Cascade)
  toEvent     Event  @relation("EventTo", fields: [toEventId], references: [id], onDelete: Cascade)

  @@id([fromEventId, toEventId])
}

model IndustryNode {
  id        String         @id @default(cuid())
  name      String
  slug      String         @unique
  parentId  String?
  sortOrder Int            @default(0)
  parent    IndustryNode?  @relation("IndustryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  IndustryNode[] @relation("IndustryTree")

  @@index([parentId, sortOrder])
}

model KeywordSubscription {
  id         String          @id @default(cuid())
  userId     String
  keyword    String
  normalized String
  enabled    Boolean         @default(true)
  realtime   Boolean         @default(true)
  createdAt  DateTime        @default(now())
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  alerts     AlertDelivery[]

  @@unique([userId, normalized])
  @@index([normalized, enabled])
}

model AlertDelivery {
  id         String               @id @default(cuid())
  userId     String
  eventId    String
  keywordId  String?
  status     AlertStatus          @default(PENDING)
  providerId String?
  error      String?
  sentAt     DateTime?
  createdAt  DateTime             @default(now())
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  event      Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  keyword    KeywordSubscription? @relation(fields: [keywordId], references: [id], onDelete: SetNull)

  @@unique([userId, eventId, keywordId])
  @@index([status, createdAt])
}

model Embedding {
  id          String                      @id @default(cuid())
  documentId  String?
  entityId    String?
  contentHash String                      @unique
  model       String
  dimensions  Int
  vector      Unsupported("vector(1024)")
  createdAt   DateTime                    @default(now())
  document    RawDocument?                @relation(fields: [documentId], references: [id], onDelete: Cascade)
  entity      Entity?                     @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([entityId])
}

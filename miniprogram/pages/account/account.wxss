.identity{display:flex;align-items:center;justify-content:space-between}
input{box-sizing:border-box;width:100%;height:96rpx;border:1rpx solid #dce2de;border-radius:16rpx;padding:0 24rpx;margin-top:24rpx;background:#fff;color:#202824}
.linked{color:#21634b;background:#edf4f0;padding:20rpx 24rpx;margin:20rpx 0;border-radius:16rpx;word-break:break-all}
.status{color:#202824;background:#edf4f0;border:1rpx solid #dce2de;border-radius:20rpx;padding:24rpx;margin:24rpx 0;line-height:1.7}

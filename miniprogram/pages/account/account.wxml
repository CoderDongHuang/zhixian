<view class="shell">
  <view class="eyebrow">账号与同步</view>
  <view class="brand">接续你的阅读与学习</view>
  <view class="muted">将微信身份与已有邮箱账号关联，在不同设备延续进度。</view>
  <view class="card">
    <view class="identity"><view><view class="title">微信登录</view><view class="muted">{{loginStatus}}</view></view></view>
    <button class="button secondary" disabled="{{busy}}" bindtap="retryLogin">重新登录</button>
  </view>
  <view class="card">
    <view class="title">账号绑定</view>
    <view class="linked" wx:if="{{linked}}">已绑定：{{linkedEmail}}</view>
    <view class="muted" wx:else>使用已有账号邮箱，合并收藏与学习记录。</view>
    <input aria-label="已有账号邮箱" disabled="{{busy}}" placeholder="已有账号邮箱" value="{{email}}" bindinput="setEmail" />
    <input aria-label="邮箱验证码" disabled="{{busy}}" type="number" maxlength="6" placeholder="6 位邮箱验证码" value="{{code}}" bindinput="setCode" />
    <button class="button secondary" disabled="{{busy}}" bindtap="requestCode">获取验证码</button>
    <button class="button" disabled="{{busy}}" bindtap="bindEmail">绑定已有账号</button>
    <button class="button secondary" wx:if="{{linked}}" disabled="{{busy}}" bindtap="unbindEmail">解除绑定</button>
  </view>
  <view class="status" wx:if="{{status}}" role="status">{{status}}</view>
  <view class="card">
    <view class="title">学习同步</view>
    <view class="muted">路线：{{learningTitle || '尚未生成'}}</view>
    <view class="muted">最近任务：{{taskCount}} 个</view>
    <button class="button secondary" disabled="{{busy}}" loading="{{busy}}" bindtap="refreshSync">立即同步</button>
  </view>
  <navigator class="back-link" url="/pages/index/index" open-type="reLaunch">返回发现</navigator>
</view>

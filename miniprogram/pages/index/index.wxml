<view class="shell">
  <view class="eyebrow">发现 · AI 行业观察</view>
  <view class="brand">值得关注的行业变化</view>
  <view class="muted">从行业变化出发，用来源和证据建立判断。</view>
  <view class="account-bar">
    <view><view class="account-state">{{loginStatus}}</view><navigator url="/pages/account/account">账号绑定与学习同步 →</navigator></view>
    <button wx:if="{{error}}" size="mini" bindtap="retryLogin">重新登录</button>
  </view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:if="{{loading}}" class="loading">正在加载行业信息...</view>
  <view wx:if="{{!loading && !error && items.length === 0}}" class="card empty">暂时没有可阅读内容，下拉可以刷新。</view>
  <view class="card" wx:for="{{items}}" wx:key="id">
    <view role="button" aria-label="{{item.title}}" data-event-id="{{item.eventId}}" data-feed-id="{{item.id}}" bindtap="open">
      <view class="tag">{{item.topic}} · 可信度 {{item.confidence*100}}%</view>
      <view class="title">{{item.title}}</view>
      <view class="muted">{{item.summary}}</view>
    </view>
    <view class="card-actions"><button class="button secondary" data-feed-id="{{item.id}}" bindtap="toggleBookmark">{{item.bookmarked ? '取消收藏' : '收藏'}}</button></view>
  </view>
</view>

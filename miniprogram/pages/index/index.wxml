<view class="shell"><view class="brand">知线</view><view class="muted">值得关注的 AI 行业变化</view><navigator url="/pages/account/account">账号与学习同步</navigator><view wx:if="{{loading}}" class="muted">加载中...</view><view class="card" wx:for="{{items}}" wx:key="id"><view data-event-id="{{item.eventId}}" data-feed-id="{{item.id}}" bindtap="open"><view class="tag">{{item.topic}} · 可信度 {{item.confidence*100}}%</view><view class="title">{{item.title}}</view><view class="muted">{{item.summary}}</view></view><button size="mini" data-feed-id="{{item.id}}" bindtap="toggleBookmark">{{item.bookmarked ? '取消收藏' : '收藏'}}</button></view></view>

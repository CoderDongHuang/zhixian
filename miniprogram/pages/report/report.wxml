<view class="shell">
  <view wx:if="{{loading}}" class="muted">报告加载中...</view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <block wx:if="{{report}}">
    <view class="tag">报告试读 · {{report.topic}}</view><view class="brand">{{report.title}}</view>
    <view class="card"><view class="title">为什么重要</view><view>{{report.whyImportant}}</view></view>
    <view class="card"><view class="title">学习建议</view><view>{{report.learnerAdvice}}</view></view>
    <view class="card"><view class="title">来源</view><view class="source" wx:for="{{report.sources}}" wx:key="title">{{item.name}}：{{item.title}}</view></view>
    <button class="button" open-type="share">生成分享卡片</button>
  </block>
</view>
